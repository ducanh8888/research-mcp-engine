# Copy to .env without replacing an existing file. Empty values are not seeded.
# init/import-env encrypts direct specialist and one OmniRoute service credential.
# Commodity accounts and balancing belong in OmniRoute; manage operator routes in /admin.
OMNI_ROUTE_API_URL=
OMNI_ROUTE_API_KEY=
FIRECRAWL_API_KEY=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
CONSENSUS_API_KEY=
ELICIT_API_KEY=
GITHUB_TOKEN=

# Optional deployments of licensed or hosted adapters use account configuration.
# Do not place bearer tokens or OAuth secrets in a committed example file.

# Change these only if the runtime directory owner differs from UID/GID 1000.
RESEARCH_ENGINE_UID=1000
RESEARCH_ENGINE_GID=1000
