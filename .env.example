# Copy to .env and fill only the providers you use. Empty values are not seeded.
# research-engine init imports configured keys into the encrypted account store.
# Provider routing and subsequent credential changes use /admin.
EXA_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
JINA_API_KEY=
YOU_API_KEY=
OCTEN_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
OPENALEX_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
CROSSREF_EMAIL=
SCITE_API_KEY=
GITHUB_TOKEN=

# Optional deployments of licensed or hosted adapters use account configuration.
# Do not place bearer tokens or OAuth secrets in a committed example file.

# Change these only if the runtime directory owner differs from UID/GID 1000.
RESEARCH_ENGINE_UID=1000
RESEARCH_ENGINE_GID=1000
